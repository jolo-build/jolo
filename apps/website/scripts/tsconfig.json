{
  "extends": "../../../tsconfig.base.json",
  // Asset preparation and prerendering run under Bun; prerendering imports the browser components.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "react", "react-dom"],
    "jsx": "react-jsx"
  },
  // The Vite config sits at the workspace root but is build tooling like everything else here.
  "include": [".", "../vite.config.js"]
}

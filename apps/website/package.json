{
  "name": "@jolo/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/assets.js && vite --host 127.0.0.1",
    "build": "bun scripts/assets.js && vite build && bun scripts/prerender.jsx",
    "preview": "vite preview --host 127.0.0.1",
    "test:loading": "bun run build && bun scripts/test-loading.js",
    "deploy": "bun run build && wrangler deploy --config ../../deploy/website.wrangler.jsonc",
    "deploy:check": "bun run build && wrangler deploy --dry-run --config ../../deploy/website.wrangler.jsonc",
    "cloudflare:login": "wrangler login",
    "cloudflare:whoami": "wrangler whoami"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  }
}

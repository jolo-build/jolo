{
  "extends": "../../../tsconfig.base.json",
  // Bun runs these tests, but they import both renderer modules (DOM) and main-process modules,
  // so this program sees the union rather than either runtime on its own.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "react", "react-dom"],
    "jsx": "react-jsx"
  },
  // The renderer's ambient declarations come too: these tests render the same components, so they
  // need the same preload bridge. Its browser-runtime declarations do not, because Bun provides them.
  "include": [".", "../src/renderer/globals.d.ts"]
}
